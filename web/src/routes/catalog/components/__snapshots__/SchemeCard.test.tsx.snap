        class="flex items-center gap-2"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-shield-check h-5 w-5"
          fill="none"
          height="24"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="24"
