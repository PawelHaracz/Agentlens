            </a>
          </div>
          <div
            class="mt-2"
          >
            <div
              class="text-sm font-medium mb-1"
            >
              Scopes:
            </div>
            <table
              class="text-sm w-full"
            >
              <tbody>
                <tr>
                  <td
                    class="font-mono pr-2"
                  >
                    read
                  </td>
                  <td
                    class="text-muted-foreground"
                  >
                    Read access
                  </td>
                </tr>
                <tr>
                  <td
                    class="font-mono pr-2"
                  >
                    write
